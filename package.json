{
  "name": "@maplibre/maplibre-gl-compare",
  "version": "0.6.0-dev",
  "description": "Swipe and sync between two MapLibre maps",
  "funding": "https://github.com/maplibre/maplibre-gl-js?sponsor=1",
  "type": "module",
  "main": "dist/maplibre-gl-compare.js",
  "types": "dist/maplibre-gl-compare.d.ts",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown && cp src/style.css dist/maplibre-gl-compare.css",
    "test": "npm run build && npm run lint && playwright test",
    "lint": "eslint",
    "docs": "documentation build src/maplibre-gl-compare.ts --parse-extension=ts --format=md > API.md",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-gl-compare.git"
  },
  "keywords": [
    "maplibre",
    "maplibregl",
    "maps",
    "gl",
    "ui"
  ],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mapbox/mapbox-gl-sync-move": "^0.3.0",
    "@playwright/test": "^1.57.0",
    "documentation": "^13.2.5",
    "eslint": "^9.39.2",
    "maplibre-gl": "^2.1.6",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.1.6"
  }
}
