{
  "name": "@maplibre/maplibre-gl-compare",
  "version": "0.6.0-dev",
  "description": "Swipe and sync between two MapLibre maps",
  "funding": "https://github.com/maplibre/maplibre-gl-js?sponsor=1",
  "type": "module",
  "main": "dist/maplibre-gl-compare.js",
  "types": "dist/maplibre-gl-compare.d.ts",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "dev": "vite",
    "start": "cp style.css example/style.css && budo example/index.js --serve example/bundle.js --dir example --live",
    "build:legacy": "cp style.css dist/maplibre-gl-compare.css && NODE_ENV=production && browserify index.js | uglifyjs -c -m > dist/maplibre-gl-compare.js",
    "build": "tsdown && cp src/style.css dist/maplibre-gl-compare.css",
    "test": "npm run lint && browserify -t envify test/index.js | smokestack -b firefox | tap-status",
    "lint": "eslint",
    "docs": "documentation build src/maplibre-gl-compare.ts --parse-extension=ts --format=md > API.md",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-gl-compare.git"
  },
  "keywords": [
    "maplibre",
    "maplibregl",
    "maps",
    "gl",
    "ui"
  ],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mapbox/mapbox-gl-sync-move": "^0.3.0",
    "browserify": "^17.0.1",
    "documentation": "^13.2.5",
    "envify": "^4.1.0",
    "eslint": "^9.39.2",
    "maplibre-gl": "^2.1.6",
    "smokestack": "^3.6.0",
    "tap-status": "^1.0.1",
    "tape": "^5.5.2",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.1.6"
  }
}
